FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1
ENV HERMES_HOME=/home/tusker/.hermes
ENV HOME=/home/tusker
ENV PATH="/srv/opencode/hermes-venv/bin:/usr/local/bin:/usr/bin:/bin:/usr/games"

# API Server Configuration - bind to all interfaces for external access
ENV API_SERVER_ENABLED=true
ENV API_SERVER_HOST=0.0.0.0
ENV ZAI_API_KEY=837d46e293034dceacd901a5176d98c8.m2FBMN9WJoVaY60I
# NOTE: Set API_SERVER_KEY at runtime for production use

# Hermes-Swarm Configuration - Priority: OpenCode Zen free > OpenCode Go subscription > Free
# Primary: OpenCode Zen big-pickle (free tier - best for now)
ENV HERMES_INFERENCE_PROVIDER=zai
ENV HERMES_SWARM_PRIMARY_MODEL=zai/glm-5.1

# OpenCode Zen free models (only working ones as of 2025-04-22)
ENV HERMES_SWARM_FALLBACK_1=opencode-zen/minimax-m2.5-free
ENV HERMES_SWARM_FALLBACK_2=opencode-zen/ling-2.6-flash-free
ENV HERMES_SWARM_FALLBACK_3=opencode-zen/gpt-5-nano
ENV HERMES_SWARM_FALLBACK_4=opencode-zen/trinity-large-preview-free
ENV HERMES_SWARM_FALLBACK_5=opencode-zen/nemotron-3-super-free

# OpenCode Go models ($10/month subscription)
ENV HERMES_SWARM_FALLBACK_6=opencode-go/glm-5
ENV HERMES_SWARM_FALLBACK_7=opencode-go/kimi-k2.5
ENV HERMES_SWARM_FALLBACK_8=opencode-go/minimax-m2.7
ENV HERMES_SWARM_FALLBACK_9=opencode-go/minimax-m2.5
ENV HERMES_SWARM_FALLBACK_10=opencode-go/mimo-v2-pro

# Codex (subscription included)
ENV HERMES_SWARM_FALLBACK_11=openai/gpt-5.3-codex
ENV HERMES_SWARM_FALLBACK_12=openai/gpt-5.2-codex
ENV HERMES_SWARM_FALLBACK_13=openai/gpt-5-mini

# GitHub Copilot free
ENV HERMES_SWARM_FALLBACK_14=github-copilot/gpt-5-mini

# Google free
ENV HERMES_SWARM_FALLBACK_15=google/gemma-4-26b-a4b-it:free
ENV HERMES_SWARM_FALLBACK_16=google/gemini-2.5-flash

# NVIDIA free
ENV HERMES_SWARM_FALLBACK_17=nvidia/nemotron-nano-9b-v2:free
ENV HERMES_SWARM_FALLBACK_18=nvidia/nemotron-3-super-120b-a12b:free

# OpenRouter free
ENV HERMES_SWARM_FALLBACK_19=openrouter/google/gemma-3-5b-eu:free
ENV HERMES_SWARM_FALLBACK_20=openrouter/meta-llama/llama-3.1-8b-instruct:free
ENV HERMES_SWARM_FALLBACK_21=openrouter/mistralai/mistral-7b-instruct:free

ENV HERMES_SWARM_SELECTION_POLICY=specific-order
ENV HERMES_SWARM_MAX_TOKENS=4000
ENV HERMES_SWARM_DAILY_TOKEN_LIMIT=50000

# Hermes-Code Model - GPT-5.4 for production
ENV HERMES_CODE_MODEL=openai/gpt-5.4

# Hermes-Agentic Models - free via OpenCode Zen
ENV HERMES_AGENTIC_FULL_MODEL=opencode-zen/big-pickle
ENV HERMES_AGENTIC_REMOTE_MODEL=opencode-zen/big-pickle

# Hermes-Agent (default) - OpenCode Zen with fallback chain
# Primary uses OpenCode Zen free tier
ENV HERMES_AGENT_MODEL=opencode-zen/big-pickle

# OpenCode Zen free models (only working ones as of 2025-04-22)
ENV HERMES_AGENT_FALLBACK_1=opencode-zen/minimax-m2.5-free
ENV HERMES_AGENT_FALLBACK_2=opencode-zen/ling-2.6-flash-free
ENV HERMES_AGENT_FALLBACK_3=opencode-zen/gpt-5-nano
ENV HERMES_AGENT_FALLBACK_4=opencode-zen/trinity-large-preview-free
ENV HERMES_AGENT_FALLBACK_5=opencode-zen/nemotron-3-super-free

# OpenCode Go models ($10/month subscription)
ENV HERMES_AGENT_FALLBACK_6=opencode-go/glm-5
ENV HERMES_AGENT_FALLBACK_7=opencode-go/kimi-k2.5
ENV HERMES_AGENT_FALLBACK_8=opencode-go/minimax-m2.7
ENV HERMES_AGENT_FALLBACK_9=opencode-go/minimax-m2.5
ENV HERMES_AGENT_FALLBACK_10=opencode-go/mimo-v2-pro

# Codex fallbacks
ENV HERMES_AGENT_FALLBACK_11=openai/gpt-5.3-codex
ENV HERMES_AGENT_FALLBACK_12=openai/gpt-5.2-codex
ENV HERMES_AGENT_FALLBACK_13=openai/gpt-5-mini

# GitHub Copilot free
ENV HERMES_AGENT_FALLBACK_14=github-copilot/gpt-5-mini

# Google free
ENV HERMES_AGENT_FALLBACK_15=google/gemma-4-26b-a4b-it:free
ENV HERMES_AGENT_FALLBACK_16=google/gemini-2.5-flash

# NVIDIA free
ENV HERMES_AGENT_FALLBACK_17=nvidia/nemotron-nano-9b-v2:free
ENV HERMES_AGENT_FALLBACK_18=nvidia/nemotron-3-super-120b-a12b:free

# OpenRouter free
ENV HERMES_AGENT_FALLBACK_19=openrouter/google/gemma-3-5b-eu:free
ENV HERMES_AGENT_FALLBACK_20=openrouter/meta-llama/llama-3.1-8b-instruct:free

# Install system deps (include curl/wget/jq/ca-certificates and adduser)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential nodejs npm python3 ripgrep ffmpeg gcc python3-dev \
    libffi-dev procps curl jq wget ca-certificates adduser && \
    rm -rf /var/lib/apt/lists/*

ENV CLAUDE_CLI_PATH=/usr/local/bin/claude

# Create runtime user
RUN adduser --disabled-password --uid 1000 --gecos "" tusker || true

# Copy source
COPY --chown=tusker:tusker . /srv/opencode/hermes-agent
WORKDIR /srv/opencode/hermes-agent

# Create venv and install deps
RUN python3 -m venv /srv/opencode/hermes-venv && \
    /srv/opencode/hermes-venv/bin/pip install --no-cache-dir -e ".[all]" && \
    /srv/opencode/hermes-venv/bin/pip install --no-cache-dir "mcp[cli]"

# Create Hermes home dir and keep legacy hermes-data path aliased to it
RUN mkdir -p /home/tusker/.hermes && \
    rm -rf /home/tusker/hermes-data && \
    ln -s /home/tusker/.hermes /home/tusker/hermes-data && \
    chown -R 1000:1000 /home/tusker || mkdir -p /home/tusker/.hermes

# Install Claude binary explicitly into /usr/local/bin (final step)
# Doing this late reduces the chance of later steps removing it.
RUN set -eux; \
    GCS_BUCKET="https://storage.googleapis.com/claude-code-dist-86c565f3-f756-42ad-8dfa-d59b1c096819/claude-code-releases"; \
    VERSION=$(curl -fsSL "$GCS_BUCKET/latest"); \
    PLATFORM="linux-x64"; \
    echo "Downloading claude $VERSION $PLATFORM"; \
    curl -fsSL -o /usr/local/bin/claude "$GCS_BUCKET/$VERSION/$PLATFORM/claude"; \
    chmod +x /usr/local/bin/claude; \
    ls -la /usr/local/bin/claude; \
    /usr/local/bin/claude --version || true

USER root

EXPOSE 8642

CMD ["python", "-m", "hermes_cli.main", "gateway", "run", "--replace"]
