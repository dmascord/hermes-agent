# Hermes-Swarm Docker Deployment
# ================================
# This file defines the complete environment for the hermes-swarm container.
# Copy to .env and fill in your API keys:
#   cp .env.swarm.example .env
#
# Then deploy with:
#   docker compose up -d        # rebuilds image automatically
#   docker compose up -d --no-recreate   # start without rebuilding
#   docker compose down && docker compose up -d --build   # full rebuild + restart

# ── API Server ────────────────────────────────────────────────────────────────
